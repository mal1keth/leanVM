@@ -37,11 +37,33 @@ const RATE_SCALARS: usize = 4;
 /// A duplex sponge over Keccak-f\[1600\], in overwrite mode. The rate is lanes 0..16 and the capacity lanes
 /// 16..25. A permutation writes waiting scalar `i` over lanes `4i..4i+4`, zeroes the rest of the rate and keeps the
 /// capacity. A fifth scalar, or a challenge, permutes what waits, and every challenge takes a permutation of its own.
+// MEASUREMENT ONLY, never committed.
+pub mod count {
+    use core::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+    pub static ABSORB_FULL: AtomicUsize = AtomicUsize::new(0);
+    pub static SAMPLE_PENDING: AtomicUsize = AtomicUsize::new(0);
+    pub static SAMPLE_EMPTY: AtomicUsize = AtomicUsize::new(0);
+    pub static C4: AtomicUsize = AtomicUsize::new(0);
+    pub static C5: AtomicUsize = AtomicUsize::new(0);
+    pub static SCALARS: AtomicUsize = AtomicUsize::new(0);
+    pub static SAMPLES: AtomicUsize = AtomicUsize::new(0);
+    pub static MAXRUN: AtomicUsize = AtomicUsize::new(0);
+    pub fn report(what: &str) {
+        let [full, pending, empty, c4, c5, scalars, samples, maxrun] =
+            [&ABSORB_FULL, &SAMPLE_PENDING, &SAMPLE_EMPTY, &C4, &C5, &SCALARS, &SAMPLES, &MAXRUN].map(|c| c.swap(0, Relaxed));
+        eprintln!(
+            "FSCOUNT {what}: scalars={scalars} samples={samples} perms={} (absorb_full={full} sample_pending={pending} sample_empty={empty}) C4_perms={} C5_perms={} longest_run={maxrun}",
+            full + pending + empty, full + c4, full + c5
+        );
+    }
+}
+
 #[derive(Clone, Debug)]
 pub struct Sponge {
     state: [u64; STATE_LANES],
     pending: [(E, u64); RATE_SCALARS],
     n_pending: usize,
+    run: usize,
 }
 
