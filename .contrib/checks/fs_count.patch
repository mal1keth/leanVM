@@ -57,6 +79,7 @@ impl Sponge {
             },
             pending: [(ZERO, 0); RATE_SCALARS],
             n_pending: 0,
+            run: 0,
         }
     }
 
@@ -72,7 +95,11 @@ impl Sponge {
     }
 
     fn absorb(&mut self, value: E, tag: u64) {
+        use core::sync::atomic::Ordering::Relaxed;
+        self.run = 0;
+        count::SCALARS.fetch_add(1, Relaxed);
         if self.n_pending == RATE_SCALARS {
+            count::ABSORB_FULL.fetch_add(1, Relaxed);
             self.duplex();
         }
         self.pending[self.n_pending] = (value, tag);
@@ -84,6 +111,13 @@ impl Sponge {
     }
 
     pub fn sample(&mut self) -> E {
+        use core::sync::atomic::Ordering::Relaxed;
+        count::SAMPLES.fetch_add(1, Relaxed);
+        if self.n_pending > 0 { count::SAMPLE_PENDING.fetch_add(1, Relaxed); } else { count::SAMPLE_EMPTY.fetch_add(1, Relaxed); }
+        if self.run % 4 == 0 { count::C4.fetch_add(1, Relaxed); }
+        if self.run % 5 == 0 { count::C5.fetch_add(1, Relaxed); }
+        self.run += 1;
+        count::MAXRUN.fetch_max(self.run, Relaxed);
         self.duplex();
         E::new(self.state[0], self.state[1], self.state[2])
     }
